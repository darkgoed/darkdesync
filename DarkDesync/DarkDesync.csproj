<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DarkDesync</RootNamespace>
    <AssemblyName>DarkDesync</AssemblyName>
    <ApplicationIcon />
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Copy WinDivert binaries to output -->
  <ItemGroup>
    <None Include="..\WinDivert-2.2.2\WinDivert-2.2.2-A\x64\WinDivert.dll" CopyToOutputDirectory="PreserveNewest" Link="WinDivert.dll" />
    <None Include="..\WinDivert-2.2.2\WinDivert-2.2.2-A\x64\WinDivert64.sys" CopyToOutputDirectory="PreserveNewest" Link="WinDivert64.sys" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DarkDesync.Tests" />
    <InternalsVisibleTo Include="DarkDesync.UiTests" />
  </ItemGroup>
</Project>
