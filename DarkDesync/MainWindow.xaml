<Window x:Class="DarkDesync.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:DarkDesync"
 Title="DarkDesync" Width="1000" Height="640" MinWidth="900" MinHeight="560"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}"
 FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True"
 PreviewKeyDown="StartStop_PreviewKey" PreviewKeyUp="StartStop_PreviewKey">
 <Window.Resources>
  <local:EffectRatingBindingProxy x:Key="RatingContext" Data="{Binding}" />
  <local:EffectRatingConverter x:Key="EffectRatingConverter" />
  <DataTemplate x:Key="EffectOptionTemplate">
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
    <Border CornerRadius="9" Padding="7,3" Margin="8,0,0,0">
     <Border.Background><MultiBinding Converter="{StaticResource EffectRatingConverter}" ConverterParameter="Background"><Binding /><Binding Source="{StaticResource RatingContext}" Path="Data.DiagnosticCycleDurationMs" /></MultiBinding></Border.Background>
     <Border.ToolTip><MultiBinding Converter="{StaticResource EffectRatingConverter}" ConverterParameter="Note"><Binding /><Binding Source="{StaticResource RatingContext}" Path="Data.DiagnosticCycleDurationMs" /></MultiBinding></Border.ToolTip>
     <TextBlock FontSize="10" FontWeight="SemiBold">
      <TextBlock.Text><MultiBinding Converter="{StaticResource EffectRatingConverter}"><Binding /><Binding Source="{StaticResource RatingContext}" Path="Data.DiagnosticCycleDurationMs" /></MultiBinding></TextBlock.Text>
      <TextBlock.Foreground><MultiBinding Converter="{StaticResource EffectRatingConverter}" ConverterParameter="Foreground"><Binding /><Binding Source="{StaticResource RatingContext}" Path="Data.DiagnosticCycleDurationMs" /></MultiBinding></TextBlock.Foreground>
     </TextBlock>
    </Border>
   </StackPanel>
  </DataTemplate>
  <Style x:Key="PrimaryStyle" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" /><Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Surface" Background="#1A1C24" BorderBrush="#333644" BorderThickness="1" CornerRadius="9" Padding="16,12"><ContentPresenter /></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#30283F" /><Setter TargetName="Surface" Property="BorderBrush" Value="#A78BFA" /></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#BBA6FF" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#5EEAD4" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
 <Grid x:Name="PanelRoot" Background="{StaticResource BgDarkBrush}" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
  <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Border BorderBrush="#252733" BorderThickness="0,0,0,1">
   <Grid Margin="24,0,6,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◈" Foreground="{StaticResource AccentBrush}" FontSize="23" Margin="0,0,10,0" /><TextBlock Text="DarkDesync" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" /><TextBlock Text=" / OUTBOUND LAB" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" /></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Content="—" Width="38" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Click="Minimize_Click" AutomationProperties.Name="Minimizar" />
     <Button Content="□" Width="38" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Click="Maximize_Click" AutomationProperties.Name="Maximizar" />
     <Button Content="×" Width="38" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Click="Close_Click" AutomationProperties.Name="Fechar" />
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="28,20,28,16" KeyboardNavigation.TabNavigation="Cycle">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18">
    <StackPanel><TextBlock Text="Seu próximo pulso." FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Escolha o efeito, defina o tempo e use Espaço para aplicar." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" /></StackPanel>

   </Grid>
   <Grid Grid.Row="1" x:Name="ConfigurationArea" VerticalAlignment="Top">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <StackPanel x:Name="EffectArea">
     <Grid Margin="0,0,0,10"><TextBlock Text="Efeitos de pulso (4)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" /><CheckBox Content="Habilitado" IsChecked="{Binding CycleProfileEnabled}" HorizontalAlignment="Right" FontSize="11" /></Grid>
     <ComboBox x:Name="EffectSelector" ItemsSource="{Binding DiagnosticModeOptions}" SelectedItem="{Binding SelectedOutboundEffect}" ItemTemplate="{StaticResource EffectOptionTemplate}" TabIndex="0" AutomationProperties.Name="Efeito de saída" MinHeight="44" />
     <TextBlock Text="Avaliação pessoal por duração" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,7,0,16" />
     <Border x:Name="EffectRatingChip" Background="{Binding EffectRatingBackground}" CornerRadius="10" Padding="9,4" HorizontalAlignment="Left"><TextBlock x:Name="EffectRatingLabel" Text="{Binding EffectRatingText}" Foreground="{Binding EffectRatingForeground}" FontWeight="SemiBold" FontSize="11" /></Border>
     <TextBlock x:Name="EffectRatingNote" Text="{Binding EffectRatingNote}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,8" MaxHeight="74" FontSize="11" />
     <TextBlock Text="Sobre este efeito" Foreground="{StaticResource TextMutedBrush}" FontSize="11" ToolTip="{Binding EffectSupportText}" />
     <TextBlock x:Name="UnavailableTechniques" Text="Indisponíveis: UDMUX · Multipath · NAT" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" ToolTip="UDMUX: canais externos não comprovados. Multipath: exige duas rotas reais e topologia própria; IfIdx outbound é ignorado. NAT rebinding: exige gateway/NAT e servidor próprios com prova do mapeamento externo. Não são efeitos acionáveis." />

     <TextBlock Text="{Binding MtuLabSummary}" Visibility="{Binding IsMtuLabSelected, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
    <StackPanel Grid.Column="2" x:Name="DurationArea">
     <TextBlock Text="ESTILO · PRÓXIMO PULSO" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10" />
     <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <RadioButton x:Name="LegitStyleButton" Style="{StaticResource PrimaryStyle}" GroupName="PulseStyle" IsChecked="{Binding IsLegitStyle, Mode=TwoWay}" TabIndex="1" AutomationProperties.Name="Legit 250 ms"><StackPanel><TextBlock Text="Legit" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="250 ms" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" /></StackPanel></RadioButton>
      <RadioButton x:Name="AggressiveStyleButton" Grid.Column="2" Style="{StaticResource PrimaryStyle}" GroupName="PulseStyle" IsChecked="{Binding IsAggressiveStyle, Mode=TwoWay}" TabIndex="2" AutomationProperties.Name="Agressivo 800 ms"><StackPanel><TextBlock Text="Agressivo" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="800 ms" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" /></StackPanel></RadioButton>
     </Grid>
     <TextBlock Text="{Binding PulseStyleHelpText}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,12" MinHeight="30" />
     <Grid><CheckBox x:Name="ManualDurationToggle" Content="Teste manual" IsChecked="{Binding IsManualDurationEnabled}" VerticalAlignment="Center" TabIndex="3" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="DurationEditor" Text="{Binding DiagnosticCycleDurationMs, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8,5" IsEnabled="{Binding IsManualDurationEnabled}" TabIndex="4" AutomationProperties.Name="Duração manual em milissegundos" /><TextBlock Text="ms" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="7,0,0,0" /></StackPanel></Grid>
     <Slider x:Name="DurationSlider" Minimum="0" Maximum="800" Value="{Binding DiagnosticCycleDurationMs}" IsEnabled="{Binding IsManualDurationEnabled}" SmallChange="5" LargeChange="50" TabIndex="5" Margin="0,6,0,0" AutomationProperties.Name="Ajuste manual do próximo pulso" />
     <Grid Visibility="{Binding IsDscpSelected, Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0"><TextBlock Text="DSCP · próximo pulso (0–63)" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" /><TextBox x:Name="DscpEditor" Text="{Binding DscpCodepoint, UpdateSourceTrigger=PropertyChanged}" Width="64" HorizontalAlignment="Right" Padding="8,4" AutomationProperties.Name="DSCP de zero a 63" /></Grid>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="2" Margin="0,12,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock x:Name="OutboundScope" Text="GLOBAL · saída de todos os aplicativos. Use apenas em laboratório autorizado." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,10" />
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="12" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <Button x:Name="StartStopButton" Content="{Binding EngineToggleText}" Command="{Binding ToggleEngineCommand}" Style="{StaticResource ModernButton}" Height="44" FontSize="14" TabIndex="6" AutomationProperties.AutomationId="StartStopButton" />
     <Button x:Name="ManualPulseButton" Grid.Column="2" Content="Pulso manual" Command="{Binding TriggerCycleCommand}" Style="{StaticResource OutlineButton}" Height="44" TabIndex="7" />
     <Border Grid.Column="3" Background="#0B0D14" BorderBrush="#333644" BorderThickness="1" CornerRadius="12" Padding="12,5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"><TextBlock x:Name="CompactCaptureState" Text="{Binding CompactStateText}" Foreground="{Binding StatusColorBrush}" FontWeight="SemiBold" FontSize="12" /></Border>
     <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="ATALHO" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" /><ComboBox x:Name="HotkeySelector" ItemsSource="{Binding AvailableHotkeys.Keys}" SelectedItem="{Binding SelectedHotkeyName}" Width="122" TabIndex="8" AutomationProperties.Name="Atalho global" /></StackPanel>
    </Grid>
   </Grid>
   <TextBlock x:Name="StartStatus" Grid.Row="3" Text="{Binding CompactStartErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
   <Grid Grid.Row="4"><TextBlock Text="{Binding CompactSettingsStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,310,0" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="SaveSettingsButton" Content="Salvar" Command="{Binding SaveSettingsCommand}" Style="{StaticResource OutlineButton}" Padding="14,7" TabIndex="9" />
    <Button x:Name="LoadSettingsButton" Content="Carregar" Command="{Binding LoadSettingsCommand}" Style="{StaticResource OutlineButton}" Padding="14,7" Margin="8,0,0,0" TabIndex="10" />
    <Button x:Name="ResetSettingsButton" Content="Padrões" Command="{Binding ResetSettingsCommand}" Style="{StaticResource OutlineButton}" Padding="14,7" Margin="8,0,0,0" TabIndex="11" />
   </StackPanel></Grid>
  </Grid>
 </Grid>
</Window>
