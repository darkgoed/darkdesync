<Window x:Class="DarkDesync.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="DarkDesync" Width="1000" Height="640" MinWidth="900" MinHeight="560"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}"
 FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
 <Grid Background="{StaticResource BgDarkBrush}" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
  <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="36" /></Grid.RowDefinitions>
  <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="24,0,8,0"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="D /" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="17" Margin="0,0,12,0" /><TextBlock Text="DARKDESYNC" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="NETWORK LAB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="16,0,0,0" VerticalAlignment="Center" /></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Content="—" Width="42" Style="{StaticResource OutlineButton}" Background="Transparent" BorderThickness="0" ToolTip="Minimizar" Click="Minimize_Click" />
    <Button Content="□" Width="42" Style="{StaticResource OutlineButton}" Background="Transparent" BorderThickness="0" ToolTip="Maximizar / restaurar" Click="Maximize_Click" />
    <Button Content="×" Width="42" FontSize="20" Style="{StaticResource DangerButton}" Background="Transparent" BorderThickness="0" ToolTip="Fechar" Click="Close_Click" />
   </StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="24,22,24,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="Controle de tráfego" FontSize="26" FontWeight="SemiBold" />
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#252331" CornerRadius="7" Padding="12,10" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{Binding StatusColorBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" /></StackPanel></Border>
     <Button x:Name="StartStopButton" AutomationProperties.AutomationId="StartStopButton" Content="{Binding EngineToggleText}" Command="{Binding ToggleEngineCommand}" PreviewKeyDown="StartStop_PreviewKey" PreviewKeyUp="StartStop_PreviewKey" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" />
     <Button Content="Pulso manual →" Focusable="False" Command="{Binding TriggerCycleCommand}" Style="{StaticResource ModernButton}" Margin="0,0,8,0" />
     <Button Content="Cancelar" Visibility="{Binding IsStrictCaptureMode, Converter={StaticResource BoolVisibility}}" Command="{Binding CancelCycleCommand}" Style="{StaticResource DangerButton}" />
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel>
     <Border Style="{StaticResource CardPanel}"><StackPanel>
      <TextBlock Text="CAPTURA" Style="{StaticResource SectionLabel}" />
      <TextBlock x:Name="OutboundScope" Text="Outbound · todos os aplicativos" FontWeight="SemiBold" />
      <TextBlock x:Name="CaptureState" Text="{Binding CaptureStateText}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding StatusColorBrush}" Margin="0,12,0,4" />
      <TextBlock Text="Alcance GLOBAL: o pulso pode afetar a saída de TODOS os aplicativos do Windows. START somente arma; STOP encerra e libera os pacotes retidos." Style="{StaticResource HelpText}" />
      <TextBlock x:Name="StartStatus" Text="{Binding StartStatusText}" TextWrapping="Wrap" Margin="0,12,0,0" />
      <Button x:Name="CopyDiagnosticButton" Content="Copiar diagnóstico" Command="{Binding CopyDiagnosticCommand}" Style="{StaticResource OutlineButton}" Margin="0,10,0,0" ToolTip="Copia somente estado e códigos de erro, sem IP/portas ou nomes de processos. Envie ao suporte após tentar START." />
      <Expander Header="Diagnóstico de captura" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0"><StackPanel>
       <TextBlock x:Name="NetworkScopeDiagnostics" Text="{Binding NetworkDiagnosticsText}" Style="{StaticResource HelpText}" />

      </StackPanel></Expander>
     </StackPanel></Border>
     <Border Style="{StaticResource CardPanel}" Margin="0,16,0,0"><StackPanel>
      <TextBlock Text="EFEITO" Style="{StaticResource SectionLabel}" />
      <TextBlock Text="Ranking pessoal · avaliação a 250 ms" Style="{StaticResource HelpText}" />
      <TextBlock Text="Não altera a duração do pulso abaixo." Style="{StaticResource HelpText}" />
      <CheckBox Content="Habilitado" IsChecked="{Binding CycleProfileEnabled, Mode=TwoWay}" Margin="0,0,0,12" />
      <ComboBox ItemsSource="{Binding DiagnosticModeOptions}" SelectedItem="{Binding SelectedOutboundEffect}" Margin="0,0,0,16" />
      <CheckBox x:Name="PacketSizeConsent" Content="Consinto: Packet Size-Aware · todos os aplicativos" IsChecked="{Binding GlobalPacketSizeConsent}" Visibility="{Binding IsGlobalPacketSizeSelected, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12" ToolTip="Afeta apenas datagramas IPv4 de saída; os demais tráfegos passam sem efeito. Consentimento não é salvo; mudar efeito ou carregar configurações revoga." />
      <Grid><TextBlock Text="Pulso · ms" /><TextBox Text="{Binding DiagnosticCycleDurationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="78" HorizontalAlignment="Right" /></Grid>
      <Slider Minimum="0" Maximum="800" Value="{Binding DiagnosticCycleDurationMs, Mode=TwoWay}" SmallChange="5" LargeChange="50" Margin="0,6,0,0" />
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel>
     <Border Style="{StaticResource CardPanel}"><StackPanel>
      <TextBlock Text="ATALHO" Style="{StaticResource SectionLabel}" />
      <ComboBox ItemsSource="{Binding AvailableHotkeys.Keys}" SelectedItem="{Binding SelectedHotkeyName}" />
     </StackPanel></Border>
     <Expander Header="Diagnóstico · eventos do sistema" Foreground="{StaticResource TextMutedBrush}" Margin="4,18,4,0"><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11" Height="140" Margin="0,10,0,0" /></Expander>
    </StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="24,0,24,14"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBlock VerticalAlignment="Center" Text="{Binding SettingsStatus}" FontSize="12" ToolTip="{Binding SettingsPath}" TextTrimming="CharacterEllipsis" />
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"><Button Content="Salvar" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ModernButton}" Margin="0,0,8,0" /><Button Content="Carregar" Command="{Binding LoadSettingsCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" /><Button Content="Padrões" Command="{Binding ResetSettingsCommand}" Style="{StaticResource OutlineButton}" /></StackPanel>
  </Grid></Border>
  <Border Grid.Row="3" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="24,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding FilterStatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilterStatusText}" /><TextBlock Grid.Column="1" Text="WINDIVERT / AMBIENTE AUTORIZADO" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0" /></Grid></Border>
 </Grid>
</Window>
